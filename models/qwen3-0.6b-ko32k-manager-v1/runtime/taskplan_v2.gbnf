root ::= ok-plan | message-plan
message-plan ::= "{\"status\":" ("\"clarify\"" | "\"unsupported\"") ",\"message\":" text ",\"tasks\":[],\"outputs\":[]}"
ok-plan ::= plan-1 | plan-2 | plan-3 | plan-4 | plan-5 | plan-6 | plan-7 | plan-8
plan-1 ::= "{\"status\":\"ok\",\"tasks\":[" task-0 "],\"outputs\":[" out-1 "]}"
out-1 ::= "0"
plan-2 ::= "{\"status\":\"ok\",\"tasks\":[" task-0 "," task-1 "],\"outputs\":[" out-2 ("," out-2){0,1} "]}"
out-2 ::= "0" | "1"
plan-3 ::= "{\"status\":\"ok\",\"tasks\":[" task-0 "," task-1 "," task-2 "],\"outputs\":[" out-3 ("," out-3){0,2} "]}"
out-3 ::= "0" | "1" | "2"
plan-4 ::= "{\"status\":\"ok\",\"tasks\":[" task-0 "," task-1 "," task-2 "," task-3 "],\"outputs\":[" out-4 ("," out-4){0,3} "]}"
