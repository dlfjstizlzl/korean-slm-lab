text ::= "\"" text-first text-char* "\""
text-first ::= [^"\\\x00-\x20\x7F\x80-\xA0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF\uFFFD] | escape
text-char ::= [^"\\\x00-\x1F\x7F\x80-\x9F\uFFFD] | escape
escape ::= "\\" ["\\/]
