plan-8 ::= "{\"status\":\"ok\",\"tasks\":[" task-0 "," task-1 "," task-2 "," task-3 "," task-4 "," task-5 "," task-6 "," task-7 "],\"outputs\":[" out-8 ("," out-8){0,7} "]}"
out-8 ::= "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7"
